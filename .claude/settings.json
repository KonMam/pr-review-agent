{
  "extraKnownMarketplaces": {
    "konmam": {
      "source": {
        "source": "directory",
        "path": "/Users/konstantinas.m/projects/agent-harness"
      }
    }
  },
  "enabledPlugins": {
    "harness@konmam": true
  },
  "permissions": {
    "allow": [
      "Bash(./verify.sh)",
      "Bash(git status*)",
